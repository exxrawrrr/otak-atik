{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/otak-atik/adapter.schema.json",
  "title": "otak-atik adapter manifest",
  "type": "object",
  "required": ["id", "version", "provider", "transport"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
