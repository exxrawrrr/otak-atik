{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "otak-atik evidence record",
  "type": "object",
  "required": ["check", "status", "source", "detail", "artifacts", "recorded_at"],
  "properties": {
    "check": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["PASS", "FAIL", "CHANGED", "COULD_NOT_VERIFY"]
    },
    "source": {"type": "string"},
    "detail": {"type": "string"},
    "artifacts": {"type": "array"},
    "recorded_at": {"type": "string"}
  }
}
